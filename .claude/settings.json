{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(which *)",
      "Bash(tsx *)",
      "Bash(tsc *)",
      "Bash(deno *)",
      "Bash(supabase *)",
      "Bash(wrangler *)",
      "Bash(curl -s *)",
      "Bash(python3 *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(chmod *)",
      "Bash(vitest *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:docs.supabase.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:www.anthropic.com)",
      "mcp__plugin_supabase_supabase__execute_sql",
      "mcp__plugin_supabase_supabase__list_tables",
      "mcp__plugin_supabase_supabase__get_logs",
      "mcp__plugin_supabase_supabase__deploy_edge_function",
      "mcp__plugin_supabase_supabase__apply_migration",
      "mcp__plugin_supabase_supabase__list_edge_functions",
      "mcp__supabase__execute_sql",
      "mcp__supabase__list_tables",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__apply_migration"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(curl * | bash)",
      "Bash(* --no-verify *)",
      "Read(**/.env*)",
      "Write(**/.env*)"
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  }
}
