{
  "name": "waldo-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:node": "pnpm --filter @waldo/contracts test",
    "verify:workers": "pnpm --filter @waldo/runtime test",
    "verify:property": "pnpm --filter @waldo/runtime test:property",
    "verify:mutation": "pnpm --filter @waldo/runtime test:mutation",
    "verify:guards": "node scripts/guards/run-all.mjs",
    "verify": "node scripts/guards/guard-package-manager.mjs && pnpm install --frozen-lockfile && pnpm -r typecheck && pnpm verify:node && pnpm verify:workers && pnpm verify:guards"
  }
}
