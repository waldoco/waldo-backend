{
  "name": "waldo-runtime",
  "main": "src/entry.ts",
  "compatibility_date": "2026-06-16",
  // Invocation logs include full request URLs. Keep structured console hop logs, but do not
  // persist automatic URLs while connect tickets live in /c/<ticket> and OAuth callbacks
  // carry code/state in the query. Enable traces only after issue #205's privacy gate.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Trace identity. WALDO_ENVIRONMENT must name the deploy target so Langfuse can split
  // staging from production; WALDO_RELEASE is the fallback only - the deploy wrapper
  // (scripts/deploy-runtime.sh) restamps it with the git SHA on every deploy.
  // WALDO_OWNER_TELEGRAM_ID top level stays empty: production sets its own owner routing fresh
  // (never copied from staging); empty string keeps the single-owner fallback disabled there.
  // WALDO_EGRESS_ALLOWLIST: browse-tool egress host list. Empty in production = fail-closed;
  // staging opens the public web with "*" (private and internal addresses stay blocked; "-host" entries add a deny list). guard-wrangler-local-bindings requires the key in both.
  // GMAIL_PUSH_PROJECT: the Google Cloud project holding this environment's Gmail push topic. Empty in production keeps
  // Gmail push off until the production project exists; staging names the dev project.
  // PHONE_SMS_COUNTRIES / PHONE_SMS_DAILY_LIMIT: the country codes a Twilio Verify code may be texted to, and the cap on
  // texts per UTC day across the server (the ledger holds it to 200). Read only while PHONE_SMS_VERIFY is "1"; see the
  // production runbook for what must be set up in Twilio first.
  // WALDO_MODEL_PROVIDER: the provider that runs the owner path, "anthropic" (Sonnet turns, Haiku side jobs; the default
  // when unset) or "openai" (Terra turns, Luna side jobs). The other provider is every route's fallback when its key is
  // deployed, and a chosen provider without its key yields to the one that has it. Both stay "openai" until the
  // environment's ANTHROPIC_API_KEY passes a live check and BRAVE_SEARCH_API_KEY is set (Claude has no hosted search, so
  // without it Claude turns have no web search); flipping back to "openai" is the rollback. An unrecognised value runs
  // the default and logs model_provider_unrecognised.
  // WALDO_TOOL_SEARCH: "on" sends the core tools up front and the rest behind the provider's tool search; "off" sends
  // every tool on every round, and is the rollback.
  // WALDO_TOOL_LOADER: "harness" sends the core tools plus find_tools and use_tool on any provider, with the rest named in
  // the system prompt's tool catalogue; it wins over WALDO_TOOL_SEARCH. "off" is the rollback.
  // WALDO_COMPACTION: "on" summarises the oldest part of a long app chat into one row the model reads first; "off" keeps
  // the plain window, and is the rollback.
  // WALDO_STEPPED_WINDOW: "1" cuts a chat's history in steps once it outgrows the budget and holds the start between cuts,
  // so the provider reads the same leading history from its cache turn after turn; "0" drops the oldest row every turn, and
  // is the rollback.
  // WALDO_SWITCHES: every feature switch and tuning knob, one JSON var, because Cloudflare caps a Worker at 128 vars and
  // secrets together. Each entry seam flattens it into env (src/switches.ts). A new switch goes in it, as a string, in
  // both environments; only the vars guard-switches-binding.mjs lists stay flat.
  "vars": {
    "WALDO_ENVIRONMENT": "production",
    "WALDO_PUBLIC_ORIGIN": "",
    "WALDO_OWNER_DO_NAMESPACE": "",
    "WALDO_RELEASE": "unreleased",
    "WALDO_OWNER_TELEGRAM_ID": "",
    "WALDO_MCP_SERVERS": "[]",
    "GMAIL_PUSH_PROJECT": "",
    "LANGFUSE_CAPTURE_TEXT": "false",
    "WALDO_EGRESS_ALLOWLIST": "",
    "IMESSAGE_CONNECTOR_POLICY": "",
    "IMESSAGE_ONBOARDING_URL": "",
    "IMESSAGE_WALDO_ADDRESS": "",
    "PHOTON_PROJECT_ID": "",
    "WHATSAPP_REENGAGE_TEMPLATE": "",
    "WHATSAPP_REENGAGE_TEMPLATE_LANGUAGE": "",
    "WHATSAPP_PROACTIVE_TEMPLATE": "",
    "WHATSAPP_PROACTIVE_TEMPLATE_LANGUAGE": "",
    "WHATSAPP_ONBOARDING_URL": "",
    "WHATSAPP_WALDO_NUMBER": "",
    "WHATSAPP_DEBUG_LOG": "false",
    "WALDO_MODEL_PROVIDER": "openai",
    "AGENT_MAIL_DOMAIN": "",
    "AGENT_MAIL_ZONE_ID": "",
    "WALDO_SWITCHES": {
      "CALENDAR_GROUNDED_PREP": "0",
      "PREP_PUSH_NAMES": "0",
      "WALDO_DAY_STATE": "0",
      "UPDATE_PUSH_NAMES": "0",
      "DRIVE_READS": "0",
      "APP_AGREEMENTS": "0",
      "OWNER_LOOKUP": "0",
      "OWNER_PROFILE": "0",
      "MEMORY_SEMANTIC_RECALL": "0",
      "MEMORY_SELECTION": "0",
      "PHONE_SMS_VERIFY": "0",
      "PHONE_SMS_COUNTRIES": "+91",
      "PHONE_SMS_DAILY_LIMIT": "20",
      "CONSOLE_GOOGLE_SIGNIN": "0",
      "APP_ID_TOKEN_SIGNIN": "0",
      "OPEN_SIGNUP": "0",
      "OPEN_SIGNUP_DAILY_CAP": "10",
      "OPEN_SIGNUP_TOTAL_CAP": "80",
      "OPEN_SIGNUP_SPEND_CEILING_USD": "5",
      "MAIL_SOURCE_FOLLOWUPS": "0",
      "MCP_READ_INTENTS": "0",
      "IMESSAGE_CONNECTOR_ENABLED": "0",
      "IMESSAGE_MEDIA": "0",
      "IMESSAGE_STOP": "0",
      "IMESSAGE_VOICE": "0",
      "WALDO_IMESSAGE_PROGRESS": "0",
      "WHATSAPP_REPLY_BUTTONS": "0",
      "WHATSAPP_LIST_CARDS": "0",
      "WHATSAPP_REPLY_MERGE": "0",
      "WALDO_TASK_ASK": "0",
      "WALDO_TASK_STEER": "0",
      "WALDO_TASK_PICKUP": "0",
      "WALDO_TASK_NOTES": "0",
      "WALDO_OWNER_FIRST": "0",
      "WALDO_SECOND_MESSAGE": "0",
      "WHATSAPP_QUIET_MS": "3000",
      "WALDO_COST_LEDGER_SYNC": "off",
      "WALDO_FORGET_BARRIER": "off",
      "WALDO_TOOL_SEARCH": "off",
      "WALDO_TOOL_LOADER": "off",
      "WALDO_COMPACTION": "off",
      "WALDO_STEPPED_WINDOW": "0",
      "WALDO_STREAM_REPLIES": "off",
      "HEALTH_PROVISIONAL_SCORES": "0",
      "HEALTH_SOLO_NOTICE": "0",
      "HEALTH_TRAINING_LOAD": "0",
      "HEALTH_COACHING": "0",
      "HEALTH_ACTIONS": "0",
      "MEDICATIONS": "0",
      "SCREEN_TIME": "0",
      "HEALTH_CHARTS": "0",
      "PEOPLE_MAP": "0",
      "DEVICE_PLACE": "0",
      "DEVICE_CALENDAR": "0",
      "CALENDAR_COVERAGE": "0",
      "FREE_WINDOW_OFFERS": "0",
      "BLOCK_LIFECYCLE": "0",
      "ARRIVAL_LOOK": "0",
      "DEVICE_WEATHER": "0",
      "BROWSER_FORM_SUBMIT": "0",
      "HISTORY_ARCHIVE": "0",
      "ONBOARDING_LOOKUP": "0",
      "WELCOME_V2": "0",
      "HEALTH_EASE_WORKOUT": "0",
      "CALENDAR_UNDO_CANCEL": "0",
      "AUTONOMY_OWN_CALENDAR": "0",
      "APPROVE_IN_CHAT": "0",
      "MEMORY_NIGHTLY_SOURCE_UPDATES": "0",
      "MEMORY_DAYTIME_CONSOLIDATOR": "0",
      "MEMORY_VALIDITY": "0",
      "MEMORY_CLAIM_CONTROLS": "0",
      "MEMORY_USED_SHOWN": "0",
      "AGENT_MAIL_INBOUND": "0",
      "AGENT_MAIL_SEND": "0",
      "PLANNING_BRIEF": "0",
      "OWNER_SURFACE_DEFAULT": "0",
      "APP_CHAT_ATTACHMENTS": "0",
      "CONSOLE_HARNESS": "0",
      "WHATSAPP_STOP": "0",
      "CAPACITY_PLAN": "0",
      "TOMORROW_TODAY": "0",
      "CAPACITY_BUDGET": "0",
      "WALDO_PROMPT_V2": "0",
      "NEXT_DUE_ALARM": "0",
      "WHY_TRAIL": "0",
      "WALDO_RECALL_CHAIN": "0",
      "WALDO_FILE_TOOLS": "0",
      "WALDO_ASYNC_TOOLS": "0",
      "WALDO_JOB_OUTCOME_ROWS": "0",
      "WALDO_ONE_TIMELINE": "0",
      "WALDO_LIGHT_CHAT": "0",
      "GOOGLE_REALTIME_TRIAGE": "0",
      "WALDO_WATCHDOG": "0",
      "PROACTIVE_GATE": "0",
      "PROACTIVE_INTERRUPTS_PER_DAY": "2",
      "PROACTIVE_URGENT_PER_DAY": "1",
      "PROACTIVE_GAP_MIN": "60",
      "PROACTIVE_ACT_AHEAD": "0",
      "PROACTIVE_BOTH_DEFAULT": "0",
      "EVENT_PUSH": "0",
      "EVENT_PUSH_PER_DAY": "3",
      "PROACTIVE_OVER_TELEGRAM": "0",
      "PROACTIVE_INTERVENTIONS": "0",
      "PROACTIVE_REVIEW_EVERY_MIN": "90",
      "WAKE_BRIEF": "0",
      "WAKE_BRIEF_FRESH_MIN": "180",
      "WAKE_BRIEF_TURNS_PER_DAY": "3",
      "WORKOUT_WAKE": "0",
      "BRIEF_DAY_PLAN": "0",
      "CALENDAR_PLAN": "0"
    }
  },
  "assets": { "directory": "../dashboard-app/dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "RUNTIME_DO", "class_name": "RuntimeProbeDO" },
      { "name": "RUN_LOOP_DO", "class_name": "RunLoopDO" },
      { "name": "TRACER_DO", "class_name": "TracerDO" },
      { "name": "OWNER_DO", "class_name": "OwnerDO" },
      { "name": "DEVICE_BRIDGE_DO", "class_name": "DeviceBridgeDO" },
      { "name": "IMESSAGE_BRIDGE_DO", "class_name": "IMessageBridgeDO" },
      { "name": "TASK_WORKER_DO", "class_name": "TaskWorkerDO" }
    ]
  },
  // A5 artifact bodies (metadata lives in the owner DO; DO namespaces are per-worker, so
  // staging/prod metadata never mixes - only the body bucket is shared, keyed by random
  // artifact ids). guard-wrangler-local-bindings requires env.staging to mirror this block
  // exactly. wrangler creates the bucket on the next Mac-lane deploy; a missing binding
  // degrades to in-memory bodies, never a crash.
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "waldo-artifacts" }
  ],
  "ratelimits": [
    {
      "name": "RESPONSIBILITY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Fail-closed PR infrastructure preview: isolated DOs, no external storage/provider secrets.
  // Preview vars/bindings are not inherited. Assets and migrations stay top-level.
  "previews": {
    "vars": {
      "WALDO_ENVIRONMENT": "preview",
      "WALDO_OWNER_DO_NAMESPACE": "",
      "WALDO_RELEASE": "unreleased",
      "WALDO_OWNER_TELEGRAM_ID": "",
      "LANGFUSE_CAPTURE_TEXT": "false",
      "WALDO_EGRESS_ALLOWLIST": ""
    },
    "observability": {
      "enabled": true,
      "logs": { "enabled": true, "invocation_logs": false },
      "traces": { "enabled": false }
    },
    "durable_objects": {
      "bindings": [
        { "name": "RUNTIME_DO", "class_name": "RuntimeProbeDO" },
        { "name": "RUN_LOOP_DO", "class_name": "RunLoopDO" },
        { "name": "TRACER_DO", "class_name": "TracerDO" },
        { "name": "OWNER_DO", "class_name": "OwnerDO" },
      { "name": "DEVICE_BRIDGE_DO", "class_name": "DeviceBridgeDO" },
      { "name": "IMESSAGE_BRIDGE_DO", "class_name": "IMessageBridgeDO" },
      { "name": "TASK_WORKER_DO", "class_name": "TaskWorkerDO" }
      ]
    },
    "ratelimits": [
      { "name": "RESPONSIBILITY_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
    ]
  },
  "env": {
    // Bindings, vars and secrets are NON-INHERITABLE in wrangler environments:
    // env.staging must carry the complete binding set, not just its additions.
    // guard-wrangler-local-bindings.mjs asserts this block mirrors the top level.
    "staging": {
      "name": "waldo-runtime-staging",
      "main": "src/staging-entry.ts",
      // Testers use staging.heywaldo.in. workers.dev stays on because Telegram, Meta, Photon and Gmail push still post there;
      // setting routes would otherwise turn it off.
      "routes": [{ "pattern": "staging.heywaldo.in", "custom_domain": true }],
      "workers_dev": true,
      // A Telegram owner turn is one alarm invocation of up to 14 minutes, and each tool round re-sanitises and serialises
      // the whole request (about 0.1 s of CPU at 60k tokens), so 150 rounds can pass the 30 s default.
      "limits": { "cpu_ms": 300000 },
      // Daily health retention sweep (waldo.health_retention_sweep). Staging only: the top-level (production) config has no trigger.
      "triggers": { "crons": ["17 3 * * *"] },
      "compatibility_flags": ["nodejs_compat"],
      // Cloudflare Browser Rendering serves staging browsing, by owner ruling. Production binds no browser; guard-wrangler-local-bindings.mjs enforces both.
      "browser": { "binding": "BROWSER" },
      // Waldo sends mail as itself from <handle>@mail.heywaldo.in through Cloudflare Email Service; the subdomain is
      // onboarded for sending (cf-bounce MX, SPF, DKIM, _dmarc p=reject). Staging only: production binds no sender.
      "send_email": [{ "name": "AGENT_MAIL_SENDER" }],
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "vars": {
        "WALDO_ENVIRONMENT": "staging",
        "WALDO_PUBLIC_ORIGIN": "https://staging.heywaldo.in",
        "WALDO_OWNER_DO_NAMESPACE": "5fe34e5daa754791b45bd80638402ac6",
        "WALDO_RELEASE": "unreleased",
        "WALDO_OWNER_TELEGRAM_ID": "5458446350",
        "WALDO_MCP_SERVERS": "[{\"name\":\"gmail\",\"url\":\"https://gmailmcp.googleapis.com/mcp/v1\",\"auth\":\"google\"},{\"name\":\"calendar\",\"url\":\"https://calendarmcp.googleapis.com/mcp/v1\",\"auth\":\"google\"},{\"name\":\"drive\",\"url\":\"https://drivemcp.googleapis.com/mcp/v1\",\"auth\":\"google\"}]",
        "GMAIL_PUSH_PROJECT": "waldo-dev-492217",
        "LANGFUSE_CAPTURE_TEXT": "true",
        "WALDO_EGRESS_ALLOWLIST": "*",
        "IMESSAGE_CONNECTOR_POLICY": "{\"signatureMaxAgeMs\":60000,\"heartbeatMaxAgeMs\":90000,\"capabilityMaxAgeMs\":90000,\"maxRequestBytes\":131072,\"maxRetainedBytes\":16777216,\"maxRecords\":4096,\"pullMaxWaitMs\":0,\"deliveryDeadlineMs\":30000,\"mutationDeadlineMs\":90000,\"commitmentMaxAgeMs\":45000,\"setupLifetimeMs\":600000,\"replyHandoffMaxAgeMs\":600000,\"source\":\"staging-2026-10-13-owner-review\"}",
        "IMESSAGE_ONBOARDING_URL": "https://www.heywaldo.in/waitlist",
        "IMESSAGE_WALDO_ADDRESS": "woof@heywaldo.in",
        "PHOTON_PROJECT_ID": "0e647a94-db69-4259-81b9-e1695e0b1af3",
        "WHATSAPP_REENGAGE_TEMPLATE": "waldo_update_ready",
        "WHATSAPP_REENGAGE_TEMPLATE_LANGUAGE": "en",
        "WHATSAPP_PROACTIVE_TEMPLATE": "",
        "WHATSAPP_PROACTIVE_TEMPLATE_LANGUAGE": "",
        "WHATSAPP_ONBOARDING_URL": "https://www.heywaldo.in/waitlist",
        "WHATSAPP_WALDO_NUMBER": "919226067544",
        "WHATSAPP_DEBUG_LOG": "false",
        "WALDO_MODEL_PROVIDER": "anthropic",
        "AGENT_MAIL_DOMAIN": "mail.heywaldo.in",
        "AGENT_MAIL_ZONE_ID": "17c6baaf587bad024be55ff953a93b4a",
        "WALDO_SWITCHES": {
          "CALENDAR_GROUNDED_PREP": "1",
          "PREP_PUSH_NAMES": "1",
          "WALDO_DAY_STATE": "1",
          "UPDATE_PUSH_NAMES": "1",
          "MAIL_SOURCE_FOLLOWUPS": "1",
          "DRIVE_READS": "1",
          "APP_AGREEMENTS": "1",
          "OWNER_LOOKUP": "1",
          "OWNER_PROFILE": "1",
          "MEMORY_SEMANTIC_RECALL": "1",
          "MEMORY_SELECTION": "1",
          "PHONE_SMS_VERIFY": "1",
          "PHONE_SMS_COUNTRIES": "+91",
          "PHONE_SMS_DAILY_LIMIT": "20",
          "CONSOLE_GOOGLE_SIGNIN": "0",
          "APP_ID_TOKEN_SIGNIN": "1",
          "OPEN_SIGNUP": "1",
          "OPEN_SIGNUP_DAILY_CAP": "10",
          "OPEN_SIGNUP_TOTAL_CAP": "80",
          "OPEN_SIGNUP_SPEND_CEILING_USD": "5",
          "MCP_READ_INTENTS": "1",
          "IMESSAGE_CONNECTOR_ENABLED": "1",
          "IMESSAGE_MEDIA": "1",
          "IMESSAGE_STOP": "1",
          "IMESSAGE_VOICE": "1",
          "WALDO_IMESSAGE_PROGRESS": "0",
          "WHATSAPP_REPLY_BUTTONS": "1",
          "WHATSAPP_LIST_CARDS": "1",
          "WHATSAPP_REPLY_MERGE": "1",
          "WALDO_TASK_ASK": "1",
          "WALDO_TASK_STEER": "1",
          "WALDO_TASK_PICKUP": "1",
          "WALDO_TASK_NOTES": "1",
          "WALDO_OWNER_FIRST": "1",
          "WALDO_SECOND_MESSAGE": "1",
          "WHATSAPP_QUIET_MS": "3000",
          "WALDO_COST_LEDGER_SYNC": "on",
          "WALDO_FORGET_BARRIER": "on",
          "WALDO_TOOL_SEARCH": "off",
          "WALDO_TOOL_LOADER": "harness",
          "WALDO_COMPACTION": "on",
          "WALDO_STEPPED_WINDOW": "1",
          "WALDO_STREAM_REPLIES": "on",
          "HEALTH_PROVISIONAL_SCORES": "1",
          "HEALTH_SOLO_NOTICE": "1",
          "HEALTH_TRAINING_LOAD": "1",
          "HEALTH_COACHING": "1",
          "HEALTH_ACTIONS": "1",
          "MEDICATIONS": "1",
          "SCREEN_TIME": "1",
          "HEALTH_CHARTS": "1",
          "PEOPLE_MAP": "1",
          "DEVICE_PLACE": "1",
          "DEVICE_CALENDAR": "1",
          "CALENDAR_COVERAGE": "1",
          "FREE_WINDOW_OFFERS": "1",
          "BLOCK_LIFECYCLE": "1",
          "ARRIVAL_LOOK": "1",
          "DEVICE_WEATHER": "1",
          "BROWSER_FORM_SUBMIT": "1",
          "HISTORY_ARCHIVE": "dry",
          "ONBOARDING_LOOKUP": "1",
          "WELCOME_V2": "1",
          "HEALTH_EASE_WORKOUT": "1",
          "CALENDAR_UNDO_CANCEL": "1",
          "AUTONOMY_OWN_CALENDAR": "1",
          "APPROVE_IN_CHAT": "1",
          "MEMORY_NIGHTLY_SOURCE_UPDATES": "1",
          "MEMORY_DAYTIME_CONSOLIDATOR": "1",
          "MEMORY_VALIDITY": "1",
          "MEMORY_CLAIM_CONTROLS": "1",
          "MEMORY_USED_SHOWN": "1",
          "AGENT_MAIL_INBOUND": "1",
          "AGENT_MAIL_SEND": "1",
          "PLANNING_BRIEF": "1",
          "OWNER_SURFACE_DEFAULT": "1",
          "APP_CHAT_ATTACHMENTS": "1",
          "CONSOLE_HARNESS": "1",
          "WHATSAPP_STOP": "1",
          "CAPACITY_PLAN": "1",
          "TOMORROW_TODAY": "1",
          "CAPACITY_BUDGET": "1",
          "WALDO_PROMPT_V2": "1",
          "NEXT_DUE_ALARM": "1",
          "WHY_TRAIL": "1",
          "WALDO_RECALL_CHAIN": "1",
          "WALDO_FILE_TOOLS": "1",
          "WALDO_ASYNC_TOOLS": "1",
          "WALDO_JOB_OUTCOME_ROWS": "1",
          "WALDO_ONE_TIMELINE": "1",
          "WALDO_LIGHT_CHAT": "0",
          "GOOGLE_REALTIME_TRIAGE": "1",
          "WALDO_WATCHDOG": "1",
          "PROACTIVE_GATE": "1",
          "PROACTIVE_INTERRUPTS_PER_DAY": "2",
          "PROACTIVE_URGENT_PER_DAY": "1",
          "PROACTIVE_GAP_MIN": "60",
          "PROACTIVE_ACT_AHEAD": "1",
          "PROACTIVE_BOTH_DEFAULT": "1",
          "EVENT_PUSH": "1",
          "EVENT_PUSH_PER_DAY": "3",
          "PROACTIVE_OVER_TELEGRAM": "1",
          "PROACTIVE_INTERVENTIONS": "1",
          "PROACTIVE_REVIEW_EVERY_MIN": "90",
          "WAKE_BRIEF": "1",
          "WAKE_BRIEF_FRESH_MIN": "180",
          "WAKE_BRIEF_TURNS_PER_DAY": "3",
          "WORKOUT_WAKE": "1",
          "BRIEF_DAY_PLAN": "1",
          "CALENDAR_PLAN": "1"
        }
      },
      "assets": { "directory": "../dashboard-app/dist", "binding": "ASSETS", "run_worker_first": true },
      "durable_objects": {
        "bindings": [
          { "name": "RUNTIME_DO", "class_name": "RuntimeProbeDO" },
          { "name": "RUN_LOOP_DO", "class_name": "RunLoopDO" },
          { "name": "TRACER_DO", "class_name": "TracerDO" },
          { "name": "OWNER_DO", "class_name": "OwnerDO" },
      { "name": "DEVICE_BRIDGE_DO", "class_name": "DeviceBridgeDO" },
      { "name": "IMESSAGE_BRIDGE_DO", "class_name": "IMessageBridgeDO" },
      { "name": "TASK_WORKER_DO", "class_name": "TaskWorkerDO" }
        ]
      },
      "r2_buckets": [
        { "binding": "ARTIFACTS", "bucket_name": "waldo-artifacts" }
      ],
      "ratelimits": [
        {
          "name": "RESPONSIBILITY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RuntimeProbeDO"] },
        { "tag": "v2", "new_sqlite_classes": ["TracerDO"] },
        { "tag": "v3", "new_sqlite_classes": ["RunLoopDO"] },
        { "tag": "v4", "new_sqlite_classes": ["TelegramOwnerDO"] },
        { "tag": "v5", "new_sqlite_classes": ["DeviceBridgeDO"] },
        { "tag": "v6", "renamed_classes": [{ "from": "TelegramOwnerDO", "to": "OwnerDO" }] },
        { "tag": "v7", "new_sqlite_classes": ["IMessageBridgeDO"] },
        // v8 is reserved for the retired-class deletion (#1334); task workers take v9 and deploy after it or in the same bundle.
        { "tag": "v9", "new_sqlite_classes": ["TaskWorkerDO"] }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        { "binding": "VECTORIZE", "index_name": "waldo-recall" }
      ]
    }
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RuntimeProbeDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TracerDO"] },
    { "tag": "v3", "new_sqlite_classes": ["RunLoopDO"] },
    { "tag": "v4", "new_sqlite_classes": ["TelegramOwnerDO"] },
    { "tag": "v5", "new_sqlite_classes": ["DeviceBridgeDO"] },
    { "tag": "v6", "renamed_classes": [{ "from": "TelegramOwnerDO", "to": "OwnerDO" }] },
    { "tag": "v7", "new_sqlite_classes": ["IMessageBridgeDO"] },
    // v8 is reserved for the retired-class deletion (#1334); task workers take v9 and deploy after it or in the same bundle.
    { "tag": "v9", "new_sqlite_classes": ["TaskWorkerDO"] }
  ]
}
