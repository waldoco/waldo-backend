{
  "name": "waldo-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  // Invocation logs include full request URLs. Keep structured console hop logs, but do not
  // persist automatic URLs while connect tickets live in /c/<ticket> and OAuth callbacks
  // carry code/state in the query. Enable traces only after issue #205's privacy gate.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Trace identity. WALDO_ENVIRONMENT must name the deploy target so Langfuse can split
  // staging from production; WALDO_RELEASE is the fallback only - the deploy wrapper
  // (scripts/deploy-runtime.sh) restamps it with the git SHA on every deploy.
  // WALDO_OWNER_TELEGRAM_ID top level stays empty: production sets its own owner routing fresh
  // (never copied from staging); empty string keeps the single-owner fallback disabled there.
  // WALDO_EGRESS_ALLOWLIST: browse-tool egress host list. Empty in production = fail-closed;
  // staging names a demo set. guard-wrangler-local-bindings requires the key in both.
  "vars": { "WALDO_ENVIRONMENT": "production", "WALDO_OWNER_DO_NAMESPACE": "", "WALDO_RELEASE": "unreleased", "WALDO_OWNER_TELEGRAM_ID": "", "CALENDAR_GROUNDED_PREP": "0", "DRIVE_READS": "0", "MAIL_SOURCE_FOLLOWUPS": "0", "MCP_READ_INTENTS": "0", "LANGFUSE_CAPTURE_TEXT": "false", "WALDO_EGRESS_ALLOWLIST": "" },
  "assets": { "directory": "../dashboard-app/dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "RUNTIME_DO", "class_name": "RuntimeProbeDO" },
      { "name": "RUN_LOOP_DO", "class_name": "RunLoopDO" },
      { "name": "TRACER_DO", "class_name": "TracerDO" },
      { "name": "TELEGRAM_OWNER_DO", "class_name": "TelegramOwnerDO" }
    ]
  },
  // A5 artifact bodies (metadata lives in the owner DO; DO namespaces are per-worker, so
  // staging/prod metadata never mixes - only the body bucket is shared, keyed by random
  // artifact ids). guard-wrangler-local-bindings requires env.staging to mirror this block
  // exactly. wrangler creates the bucket on the next Mac-lane deploy; a missing binding
  // degrades to in-memory bodies, never a crash.
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "waldo-artifacts" }
  ],
  "ratelimits": [
    {
      "name": "RESPONSIBILITY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Fail-closed PR infrastructure preview: isolated DOs, no external storage/provider secrets.
  // Preview vars/bindings are not inherited. Assets and migrations stay top-level.
  "previews": {
    "vars": { "WALDO_ENVIRONMENT": "preview", "WALDO_OWNER_DO_NAMESPACE": "", "WALDO_RELEASE": "unreleased", "WALDO_OWNER_TELEGRAM_ID": "", "LANGFUSE_CAPTURE_TEXT": "false", "WALDO_EGRESS_ALLOWLIST": "" },
    "observability": {
      "enabled": true,
      "logs": { "enabled": true, "invocation_logs": false },
      "traces": { "enabled": false }
    },
    "durable_objects": {
      "bindings": [
        { "name": "RUNTIME_DO", "class_name": "RuntimeProbeDO" },
        { "name": "RUN_LOOP_DO", "class_name": "RunLoopDO" },
        { "name": "TRACER_DO", "class_name": "TracerDO" },
        { "name": "TELEGRAM_OWNER_DO", "class_name": "TelegramOwnerDO" }
      ]
    },
    "ratelimits": [
      { "name": "RESPONSIBILITY_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
    ]
  },
  "env": {
    // Bindings, vars and secrets are NON-INHERITABLE in wrangler environments:
    // env.staging must carry the complete binding set, not just its additions.
    // guard-wrangler-local-bindings.mjs asserts this block mirrors the top level.
    "staging": {
      "name": "waldo-runtime-staging",
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "vars": { "WALDO_ENVIRONMENT": "staging", "WALDO_OWNER_DO_NAMESPACE": "5fe34e5daa754791b45bd80638402ac6", "WALDO_RELEASE": "unreleased", "WALDO_OWNER_TELEGRAM_ID": "5458446350", "CALENDAR_GROUNDED_PREP": "1", "MAIL_SOURCE_FOLLOWUPS": "1", "DRIVE_READS": "1", "MCP_READ_INTENTS": "0", "LANGFUSE_CAPTURE_TEXT": "true", "WALDO_EGRESS_ALLOWLIST": "example.com,en.wikipedia.org,github.com,news.ycombinator.com,developer.mozilla.org,heywaldo.in" },
      "assets": { "directory": "../dashboard-app/dist", "binding": "ASSETS", "run_worker_first": true },
      "durable_objects": {
        "bindings": [
          { "name": "RUNTIME_DO", "class_name": "RuntimeProbeDO" },
          { "name": "RUN_LOOP_DO", "class_name": "RunLoopDO" },
          { "name": "TRACER_DO", "class_name": "TracerDO" },
          { "name": "TELEGRAM_OWNER_DO", "class_name": "TelegramOwnerDO" }
        ]
      },
      "r2_buckets": [
        { "binding": "ARTIFACTS", "bucket_name": "waldo-artifacts" }
      ],
      "ratelimits": [
        {
          "name": "RESPONSIBILITY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RuntimeProbeDO"] },
        { "tag": "v2", "new_sqlite_classes": ["TracerDO"] },
        { "tag": "v3", "new_sqlite_classes": ["RunLoopDO"] },
        { "tag": "v4", "new_sqlite_classes": ["TelegramOwnerDO"] }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        { "binding": "VECTORIZE", "index_name": "waldo-recall" }
      ]
    }
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RuntimeProbeDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TracerDO"] },
    { "tag": "v3", "new_sqlite_classes": ["RunLoopDO"] },
    { "tag": "v4", "new_sqlite_classes": ["TelegramOwnerDO"] }
  ]
}
