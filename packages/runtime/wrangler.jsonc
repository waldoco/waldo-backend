{
  "name": "waldo-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "durable_objects": {
    "bindings": [
      { "name": "RUNTIME_DO", "class_name": "RuntimeProbeDO" },
      { "name": "TRACER_DO", "class_name": "TracerDO" },
      { "name": "NOTIFICATION_RECEIVER_DO", "class_name": "NotificationReceiverDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RuntimeProbeDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TracerDO"] },
    { "tag": "v3", "new_sqlite_classes": ["NotificationReceiverDO"] }
  ]
}
