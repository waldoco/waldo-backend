{
  "name": "@waldo/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "typecheck": "pnpm typecheck:worker && pnpm typecheck:integration",
    "typecheck:worker": "tsc --noEmit",
    "typecheck:integration": "tsc --project tsconfig.integration.json --noEmit",
    "test": "vitest run",
    "test:responsibility-integration": "pnpm typecheck:integration && vitest run --config vitest.integration.config.ts",
    "test:property": "vitest run --config vitest.scribe.config.ts",
    "test:mutation": "stryker run stryker.config.mjs",
    "test:mutation:delivery-gate": "stryker run stryker.delivery-gate.config.mjs",
    "test:mutation:context-composer": "stryker run stryker.context-composer.config.mjs"
  },
  "dependencies": {
    "@waldo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@cloudflare/workers-types": "4.20260616.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.1",
    "fast-check": "4.8.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
