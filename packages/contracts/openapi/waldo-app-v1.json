{
  "openapi": "3.1.0",
  "info": {
    "title": "Waldo owner app API",
    "version": "app.v1"
  },
  "components": {
    "securitySchemes": {
      "appBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/app/v1/auth/code": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  }
                },
                "required": [
                  "email"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "202": {
            "description": "Durable admission; execution and delivery remain separate",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable or unconfirmed"
          }
        }
      }
    },
    "/app/v1/auth/verify": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{4,10}$"
                  }
                },
                "required": [
                  "email",
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "active"
                        },
                        "session_ref": {
                          "type": "string",
                          "pattern": "^sess_[a-f0-9]{64}$"
                        },
                        "account_ref": {
                          "type": "string",
                          "pattern": "^acct_[a-f0-9]{64}$"
                        },
                        "surface": {
                          "type": "string",
                          "const": "app"
                        },
                        "absolute_expires_at": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "credential": {
                          "type": "string",
                          "minLength": 20,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "state",
                        "session_ref",
                        "account_ref",
                        "surface",
                        "absolute_expires_at",
                        "credential"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "needs_invite"
                        }
                      },
                      "required": [
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Durable admission; execution and delivery remain separate",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "active"
                        },
                        "session_ref": {
                          "type": "string",
                          "pattern": "^sess_[a-f0-9]{64}$"
                        },
                        "account_ref": {
                          "type": "string",
                          "pattern": "^acct_[a-f0-9]{64}$"
                        },
                        "surface": {
                          "type": "string",
                          "const": "app"
                        },
                        "absolute_expires_at": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "credential": {
                          "type": "string",
                          "minLength": 20,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "state",
                        "session_ref",
                        "account_ref",
                        "surface",
                        "absolute_expires_at",
                        "credential"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "needs_invite"
                        }
                      },
                      "required": [
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable or unconfirmed"
          }
        }
      }
    },
    "/app/v1/session": {
      "get": {
        "security": [
          {
            "appBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "active"
                    },
                    "session_ref": {
                      "type": "string",
                      "pattern": "^sess_[a-f0-9]{64}$"
                    },
                    "account_ref": {
                      "type": "string",
                      "pattern": "^acct_[a-f0-9]{64}$"
                    },
                    "surface": {
                      "type": "string",
                      "const": "app"
                    },
                    "absolute_expires_at": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "state",
                    "session_ref",
                    "account_ref",
                    "surface",
                    "absolute_expires_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "202": {
            "description": "Durable admission; execution and delivery remain separate",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "active"
                    },
                    "session_ref": {
                      "type": "string",
                      "pattern": "^sess_[a-f0-9]{64}$"
                    },
                    "account_ref": {
                      "type": "string",
                      "pattern": "^acct_[a-f0-9]{64}$"
                    },
                    "surface": {
                      "type": "string",
                      "const": "app"
                    },
                    "absolute_expires_at": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "state",
                    "session_ref",
                    "account_ref",
                    "surface",
                    "absolute_expires_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable or unconfirmed"
          }
        }
      }
    },
    "/app/v1/auth/signout": {
      "post": {
        "security": [
          {
            "appBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "enum": [
                        "revoked",
                        "already_gone"
                      ]
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "202": {
            "description": "Durable admission; execution and delivery remain separate",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "enum": [
                        "revoked",
                        "already_gone"
                      ]
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable or unconfirmed"
          }
        }
      }
    },
    "/app/v1/chat/main": {
      "get": {
        "security": [
          {
            "appBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "user",
                              "assistant"
                            ]
                          },
                          "text": {
                            "type": "string"
                          },
                          "parts": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "text"
                                    },
                                    "text": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "text"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "operation"
                                    },
                                    "operation_id": {
                                      "type": "string"
                                    },
                                    "state": {
                                      "type": "string",
                                      "enum": [
                                        "admitted",
                                        "running",
                                        "completed",
                                        "interrupted",
                                        "revoked"
                                      ]
                                    },
                                    "message": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "operation_id",
                                    "state",
                                    "message"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "artifact"
                                    },
                                    "artifact_id": {
                                      "type": "string"
                                    },
                                    "revision": {
                                      "type": "integer",
                                      "exclusiveMinimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    "title": {
                                      "type": "string"
                                    },
                                    "download_path": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "artifact_id",
                                    "revision",
                                    "title",
                                    "download_path"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            }
                          },
                          "channel": {
                            "type": "string"
                          },
                          "parent_id": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "role",
                          "text",
                          "parts",
                          "channel",
                          "parent_id"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "next_cursor": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "messages",
                    "next_cursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "202": {
            "description": "Durable admission; execution and delivery remain separate",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "user",
                              "assistant"
                            ]
                          },
                          "text": {
                            "type": "string"
                          },
                          "parts": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "text"
                                    },
                                    "text": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "text"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "operation"
                                    },
                                    "operation_id": {
                                      "type": "string"
                                    },
                                    "state": {
                                      "type": "string",
                                      "enum": [
                                        "admitted",
                                        "running",
                                        "completed",
                                        "interrupted",
                                        "revoked"
                                      ]
                                    },
                                    "message": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "operation_id",
                                    "state",
                                    "message"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "artifact"
                                    },
                                    "artifact_id": {
                                      "type": "string"
                                    },
                                    "revision": {
                                      "type": "integer",
                                      "exclusiveMinimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    "title": {
                                      "type": "string"
                                    },
                                    "download_path": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "artifact_id",
                                    "revision",
                                    "title",
                                    "download_path"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            }
                          },
                          "channel": {
                            "type": "string"
                          },
                          "parent_id": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "role",
                          "text",
                          "parts",
                          "channel",
                          "parent_id"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "next_cursor": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "messages",
                    "next_cursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable or unconfirmed"
          }
        }
      }
    },
    "/app/v1/chat/main/messages": {
      "post": {
        "security": [
          {
            "appBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "client_message_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{8,64}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "client_message_id",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "const": true
                    },
                    "message_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "admitted",
                        "running",
                        "completed",
                        "interrupted",
                        "revoked"
                      ]
                    }
                  },
                  "required": [
                    "accepted",
                    "message_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "202": {
            "description": "Durable admission; execution and delivery remain separate",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "const": true
                    },
                    "message_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "admitted",
                        "running",
                        "completed",
                        "interrupted",
                        "revoked"
                      ]
                    }
                  },
                  "required": [
                    "accepted",
                    "message_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Session expired or revoked"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          },
          "503": {
            "description": "Unavailable or unconfirmed"
          }
        }
      }
    }
  }
}
