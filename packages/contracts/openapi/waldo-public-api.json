          "push_class": {
            "type": "string",
            "enum": [
              "brief",
              "fetch_alert",
              "adjustment",
              "pre_activity_spot",
              "constellation_first",
              "constellation_update",
              "spot_digest",
              "intervention_knock",
              "sync_error",
              "system_consent"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "apns",
              "telegram",
              "in_app"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "delivered",
              "opened",
              "reply",
              "callback_tap",
              "thumbs_up",
              "thumbs_down",
              "mute",
              "disable"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "push_class",
          "channel",
          "kind",
          "occurred_at"
        ],
        "additionalProperties": false
      },
      "PublicEngagementEventResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": false
      },
