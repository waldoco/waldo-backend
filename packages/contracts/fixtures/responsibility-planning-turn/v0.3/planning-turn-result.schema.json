{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.3"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema0"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "outcomeId": {
      "$ref": "#/$defs/__schema0"
    },
    "workUnitId": {
      "$ref": "#/$defs/__schema0"
    },
    "workUnitRevision": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "workUnitState": {
      "type": "string",
      "const": "planning_authorized"
    },
    "executionRequestId": {
      "$ref": "#/$defs/__schema0"
    },
    "agentSessionId": {
      "$ref": "#/$defs/__schema0"
    },
    "sessionStatus": {
      "type": "string",
      "const": "completed"
    },
    "providerInvocation": {
      "type": "object",
      "properties": {
        "executionRequestId": {
          "$ref": "#/$defs/__schema0"
        },
        "invocationKey": {
          "$ref": "#/$defs/__schema1"
        },
        "provider": {
          "type": "object",
          "properties": {
            "adapterId": {
              "$ref": "#/$defs/__schema0"
            },
            "adapterVersion": {
              "$ref": "#/$defs/__schema0"
            },
            "modelRef": {
              "$ref": "#/$defs/__schema0"
            },
            "capabilityManifest": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/__schema0"
                },
                "revision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "digest": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "required": [
                "id",
                "revision",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "adapterId",
            "adapterVersion",
            "modelRef",
            "capabilityManifest"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "const": "completed"
        },
        "resultDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "startedAt": {
          "$ref": "#/$defs/__schema2"
        },
        "completedAt": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "executionRequestId",
        "invocationKey",
        "provider",
        "status",
        "resultDigest",
        "startedAt",
        "completedAt"
      ],
      "additionalProperties": false
    },
    "candidatePlan": {
      "type": "object",
      "properties": {
        "summary": {
          "$ref": "#/$defs/__schema3"
        },
        "proposedSteps": {
          "$ref": "#/$defs/__schema4"
        },
        "openQuestions": {
          "$ref": "#/$defs/__schema6"
        },
        "constraints": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "summary",
        "proposedSteps",
        "openQuestions",
        "constraints"
      ],
      "additionalProperties": false
    },
    "projectionCursor": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "protocolVersion",
    "ownerId",
    "requestId",
    "outcomeId",
    "workUnitId",
    "workUnitRevision",
    "workUnitState",
    "executionRequestId",
    "agentSessionId",
    "sessionStatus",
    "providerInvocation",
    "candidatePlan",
    "projectionCursor"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "__schema4": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "__schema6": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "__schema8": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-planning-turn:0.3:result",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
