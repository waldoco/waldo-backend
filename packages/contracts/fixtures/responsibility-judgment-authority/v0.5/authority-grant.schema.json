{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "revision": {
      "$ref": "#/$defs/__schema2"
    },
    "judgmentRequestId": {
      "$ref": "#/$defs/__schema1"
    },
    "judgmentRequestRevision": {
      "$ref": "#/$defs/__schema2"
    },
    "judgmentDecisionId": {
      "$ref": "#/$defs/__schema1"
    },
    "grantor": {
      "$ref": "#/$defs/__schema3"
    },
    "grantee": {
      "$ref": "#/$defs/__schema4"
    },
    "subject": {
      "$ref": "#/$defs/__schema5"
    },
    "purpose": {
      "$ref": "#/$defs/__schema1"
    },
    "effectFamily": {
      "$ref": "#/$defs/__schema1"
    },
    "resources": {
      "$ref": "#/$defs/__schema6"
    },
    "scopes": {
      "$ref": "#/$defs/__schema8"
    },
    "audiences": {
      "$ref": "#/$defs/__schema9"
    },
    "argumentDigest": {
      "$ref": "#/$defs/__schema10"
    },
    "contextDigest": {
      "$ref": "#/$defs/__schema10"
    },
    "artifactDigest": {
      "$ref": "#/$defs/__schema11"
    },
    "useLimit": {
      "$ref": "#/$defs/__schema12"
    },
    "usesConsumed": {
      "$ref": "#/$defs/__schema13"
    },
    "nextUseIndex": {
      "$ref": "#/$defs/__schema14"
    },
    "validFrom": {
      "$ref": "#/$defs/__schema15"
    },
    "expiresAt": {
      "$ref": "#/$defs/__schema15"
    },
    "revocationGeneration": {
      "$ref": "#/$defs/__schema16"
    },
    "state": {
      "$ref": "#/$defs/__schema17"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema15"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema15"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "judgmentRequestId",
    "judgmentRequestRevision",
    "judgmentDecisionId",
    "grantor",
    "grantee",
    "subject",
    "purpose",
    "effectFamily",
    "resources",
    "scopes",
    "audiences",
    "argumentDigest",
    "contextDigest",
    "artifactDigest",
    "useLimit",
    "usesConsumed",
    "nextUseIndex",
    "validFrom",
    "expiresAt",
    "revocationGeneration",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.5"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "owner"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "presence",
            "person"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "work_unit"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/__schema1"
        },
        "ref": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema9": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema10": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema11": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema12": {
      "type": "number",
      "const": 1
    },
    "__schema13": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "__schema14": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "__schema15": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema17": {
      "type": "string",
      "enum": [
        "active",
        "exhausted",
        "expired",
        "revoked",
        "superseded"
      ]
    }
  },
  "$id": "urn:waldo:protocol:responsibility-judgment-authority:0.5:authority-grant",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
