{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "requestId": {
          "$ref": "#/$defs/__schema1"
        },
        "judgmentRequest": {
          "$ref": "#/$defs/__schema2"
        },
        "judgmentDecision": {
          "$ref": "#/$defs/__schema4"
        },
        "selectedOptionId": {
          "$ref": "#/$defs/__schema1"
        },
        "projectionCursor": {
          "$ref": "#/$defs/__schema3"
        },
        "authorityDisposition": {
          "type": "string",
          "const": "granted"
        },
        "grant": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema1"
            },
            "revision": {
              "$ref": "#/$defs/__schema3"
            },
            "grantee": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "service",
                    "presence",
                    "person"
                  ]
                },
                "id": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "state": {
              "type": "string",
              "const": "active"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "revocationGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "revision",
            "grantee",
            "state",
            "expiresAt",
            "revocationGeneration"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "judgmentRequest",
        "judgmentDecision",
        "selectedOptionId",
        "projectionCursor",
        "authorityDisposition",
        "grant"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "requestId": {
          "$ref": "#/$defs/__schema1"
        },
        "judgmentRequest": {
          "$ref": "#/$defs/__schema2"
        },
        "judgmentDecision": {
          "$ref": "#/$defs/__schema4"
        },
        "selectedOptionId": {
          "$ref": "#/$defs/__schema1"
        },
        "projectionCursor": {
          "$ref": "#/$defs/__schema3"
        },
        "authorityDisposition": {
          "type": "string",
          "const": "refused"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "judgmentRequest",
        "judgmentDecision",
        "selectedOptionId",
        "projectionCursor",
        "authorityDisposition"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.5"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:waldo:protocol:responsibility-judgment-authority:0.5:judgment-answer-result",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
