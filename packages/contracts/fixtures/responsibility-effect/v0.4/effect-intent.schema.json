{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "revision": {
      "$ref": "#/$defs/__schema2"
    },
    "outcome": {
      "$ref": "#/$defs/__schema3"
    },
    "workUnit": {
      "$ref": "#/$defs/__schema3"
    },
    "judgment": {
      "$ref": "#/$defs/__schema5"
    },
    "authority": {
      "$ref": "#/$defs/__schema6"
    },
    "purpose": {
      "$ref": "#/$defs/__schema1"
    },
    "effectFamily": {
      "$ref": "#/$defs/__schema1"
    },
    "argumentDigest": {
      "$ref": "#/$defs/__schema8"
    },
    "contextDigest": {
      "$ref": "#/$defs/__schema8"
    },
    "artifactDigest": {
      "$ref": "#/$defs/__schema9"
    },
    "capability": {
      "$ref": "#/$defs/__schema10"
    },
    "adapter": {
      "$ref": "#/$defs/__schema11"
    },
    "reconciliationKey": {
      "$ref": "#/$defs/__schema1"
    },
    "lease": {
      "$ref": "#/$defs/__schema12"
    },
    "cancellationGeneration": {
      "$ref": "#/$defs/__schema7"
    },
    "expiresAt": {
      "$ref": "#/$defs/__schema13"
    },
    "frozenAt": {
      "$ref": "#/$defs/__schema13"
    },
    "state": {
      "$ref": "#/$defs/__schema14"
    },
    "intentDigest": {
      "$ref": "#/$defs/__schema8"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "outcome",
    "workUnit",
    "judgment",
    "authority",
    "purpose",
    "effectFamily",
    "argumentDigest",
    "contextDigest",
    "artifactDigest",
    "capability",
    "adapter",
    "reconciliationKey",
    "lease",
    "cancellationGeneration",
    "expiresAt",
    "frozenAt",
    "state",
    "intentDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.4"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "number",
      "const": 1
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/__schema1"
        },
        "requestRevision": {
          "$ref": "#/$defs/__schema4"
        },
        "decisionId": {
          "$ref": "#/$defs/__schema1"
        },
        "decisionRevision": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "requestId",
        "requestRevision",
        "decisionId",
        "decisionRevision"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "grantId": {
          "$ref": "#/$defs/__schema1"
        },
        "grantRevision": {
          "$ref": "#/$defs/__schema4"
        },
        "useIndex": {
          "type": "number",
          "const": 1
        },
        "revocationGeneration": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "grantId",
        "grantRevision",
        "useIndex",
        "revocationGeneration"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema8": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema9": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema8"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "manifestDigest": {
          "$ref": "#/$defs/__schema8"
        },
        "eligibilityRevision": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "id",
        "version",
        "manifestDigest",
        "eligibilityRevision"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "manifestDigest": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "id",
        "version",
        "manifestDigest"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "fencingGeneration": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "id",
        "fencingGeneration"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema14": {
      "type": "string",
      "const": "frozen"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-effect:0.4:effect-intent",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
