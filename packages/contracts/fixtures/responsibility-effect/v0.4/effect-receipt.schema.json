{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "intentId": {
      "$ref": "#/$defs/__schema1"
    },
    "intentDigest": {
      "$ref": "#/$defs/__schema2"
    },
    "reconciliationKey": {
      "$ref": "#/$defs/__schema1"
    },
    "adapter": {
      "$ref": "#/$defs/__schema3"
    },
    "attempt": {
      "$ref": "#/$defs/__schema4"
    },
    "adapterOutcome": {
      "$ref": "#/$defs/__schema5"
    },
    "externalEffectRef": {
      "$ref": "#/$defs/__schema6"
    },
    "observation": {
      "$ref": "#/$defs/__schema7"
    },
    "issuedAt": {
      "$ref": "#/$defs/__schema8"
    },
    "observedAt": {
      "$ref": "#/$defs/__schema8"
    },
    "state": {
      "$ref": "#/$defs/__schema9"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "intentId",
    "intentDigest",
    "reconciliationKey",
    "adapter",
    "attempt",
    "adapterOutcome",
    "externalEffectRef",
    "observation",
    "issuedAt",
    "observedAt",
    "state"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.4"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "manifestDigest": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "id",
        "version",
        "manifestDigest"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "reported_applied",
        "reported_not_applied",
        "rejected",
        "failed",
        "timed_out"
      ]
    },
    "__schema6": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema1"
        },
        "digest": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema9": {
      "type": "string",
      "const": "observed"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-effect:0.4:effect-receipt",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
