{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "ownerId": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "subject": {
          "$ref": "#/$defs/__schema3"
        },
        "actor": {
          "$ref": "#/$defs/__schema6"
        },
        "mode": {
          "$ref": "#/$defs/__schema7"
        },
        "recordedAt": {
          "$ref": "#/$defs/__schema8"
        },
        "evidenceSetDigest": {
          "$ref": "#/$defs/__schema5"
        },
        "verifications": {
          "$ref": "#/$defs/__schema9"
        },
        "decision": {
          "$ref": "#/$defs/__schema10"
        },
        "reasonRef": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "protocolVersion",
        "id",
        "ownerId",
        "revision",
        "subject",
        "actor",
        "mode",
        "recordedAt",
        "evidenceSetDigest",
        "verifications",
        "decision",
        "reasonRef"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "ownerId": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "subject": {
          "$ref": "#/$defs/__schema3"
        },
        "actor": {
          "$ref": "#/$defs/__schema6"
        },
        "mode": {
          "$ref": "#/$defs/__schema7"
        },
        "recordedAt": {
          "$ref": "#/$defs/__schema8"
        },
        "evidenceSetDigest": {
          "$ref": "#/$defs/__schema12"
        },
        "verifications": {
          "$ref": "#/$defs/__schema13"
        },
        "decision": {
          "$ref": "#/$defs/__schema14"
        },
        "reasonRef": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "protocolVersion",
        "id",
        "ownerId",
        "revision",
        "subject",
        "actor",
        "mode",
        "recordedAt",
        "evidenceSetDigest",
        "verifications",
        "decision",
        "reasonRef"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.6"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/__schema4"
        },
        "workUnit": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "outcome",
        "workUnit"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "digest": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "owner"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "const": "explicit_owner"
    },
    "__schema8": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema9": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema10": {
      "type": "string",
      "const": "accepted"
    },
    "__schema11": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema12": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema5"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema13": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema14": {
      "type": "string",
      "const": "released"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.6:acceptance",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
