{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "eventId": {
      "$ref": "#/$defs/__schema1"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "aggregate": {
      "$ref": "#/$defs/__schema2"
    },
    "eventType": {
      "$ref": "#/$defs/__schema4"
    },
    "payloadDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "cursor": {
      "$ref": "#/$defs/__schema3"
    },
    "occurredAt": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "ownerId",
    "aggregate",
    "eventType",
    "payloadDigest",
    "cursor",
    "occurredAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.6"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "acceptance_check",
            "evidence",
            "verification",
            "acceptance"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "acceptance_check.declared",
        "evidence.admitted",
        "evidence.invalidated",
        "verification.recorded",
        "acceptance.recorded",
        "release.recorded"
      ]
    },
    "__schema5": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema6": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.6:closure-domain-event",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
