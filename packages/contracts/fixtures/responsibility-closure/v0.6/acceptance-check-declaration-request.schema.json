{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.6"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "presenceRegistrationId": {
      "$ref": "#/$defs/__schema0"
    },
    "commandType": {
      "type": "string",
      "const": "acceptance_check.declare"
    },
    "payload": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "outcome",
                "work_unit"
              ]
            },
            "id": {
              "$ref": "#/$defs/__schema0"
            },
            "expectedRevision": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "kind",
            "id",
            "expectedRevision"
          ],
          "additionalProperties": false
        },
        "criterion": {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/__schema0"
            },
            "revision": {
              "$ref": "#/$defs/__schema1"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "revision",
            "version",
            "digest"
          ],
          "additionalProperties": false
        },
        "verificationMethod": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "deterministic_read_back",
                "deterministic_artifact_check",
                "declared_semantic_check"
              ]
            },
            "capability": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "capability"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "target",
        "criterion",
        "verificationMethod"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "presenceRegistrationId",
    "commandType",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.6:acceptance-check-declaration-request",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
