{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "revision": {
      "$ref": "#/$defs/__schema2"
    },
    "digest": {
      "$ref": "#/$defs/__schema3"
    },
    "subject": {
      "$ref": "#/$defs/__schema4"
    },
    "criterion": {
      "$ref": "#/$defs/__schema6"
    },
    "verificationMethod": {
      "$ref": "#/$defs/__schema7"
    },
    "state": {
      "$ref": "#/$defs/__schema8"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema9"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema9"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "digest",
    "subject",
    "criterion",
    "verificationMethod",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.6"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/__schema5"
        },
        "workUnit": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema5"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "outcome",
        "workUnit"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "digest": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "deterministic_read_back",
            "deterministic_artifact_check",
            "declared_semantic_check"
          ]
        },
        "capability": {
          "$ref": "#/$defs/__schema1"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "material": {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/__schema1"
            },
            "digest": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "ref",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "capability",
        "version",
        "material"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ]
    },
    "__schema9": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.6:acceptance-check",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
