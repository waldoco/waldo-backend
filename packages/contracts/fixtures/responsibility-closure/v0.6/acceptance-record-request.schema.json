{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.6"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "commandType": {
      "type": "string",
      "const": "acceptance.record"
    },
    "presenceRegistrationId": {
      "$ref": "#/$defs/__schema0"
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "outcome"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "expectedRevision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "id",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "accept"
            },
            "verifications": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              },
              "uniqueItems": true
            },
            "reasonRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema0"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "decision",
            "verifications",
            "reasonRef"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "release"
            },
            "verifications": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              },
              "uniqueItems": true
            },
            "reasonRef": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "decision",
            "verifications",
            "reasonRef"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "commandType",
    "presenceRegistrationId",
    "aggregate",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.6:acceptance-record-request",
  "x-waldo-validation-level": "structural-plus-runtime-invariants",
  "x-waldo-offline-commands": "none"
}
