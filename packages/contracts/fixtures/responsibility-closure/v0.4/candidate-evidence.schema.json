{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.4"
    },
    "submissionId": {
      "$ref": "#/$defs/__schema0"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "provider",
            "execution_environment",
            "effect_adapter",
            "person"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "outcome",
            "work_unit"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "acceptanceCheckId": {
      "$ref": "#/$defs/__schema0"
    },
    "claim": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema0"
        },
        "digest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "additionalProperties": false
    },
    "artifactRefs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "protocolVersion",
    "submissionId",
    "source",
    "subject",
    "acceptanceCheckId",
    "claim",
    "artifactRefs",
    "observedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema0"
        },
        "digest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.4:candidate-evidence",
  "x-waldo-validation-level": "structural-plus-runtime-invariants"
}
