{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "revision": {
      "$ref": "#/$defs/__schema2"
    },
    "outcome": {
      "$ref": "#/$defs/__schema3"
    },
    "acceptanceCheck": {
      "$ref": "#/$defs/__schema4"
    },
    "evidence": {
      "$ref": "#/$defs/__schema6"
    },
    "evidenceSetDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "verifier": {
      "$ref": "#/$defs/__schema8"
    },
    "methodVersion": {
      "$ref": "#/$defs/__schema1"
    },
    "state": {
      "$ref": "#/$defs/__schema9"
    },
    "findingsRef": {
      "$ref": "#/$defs/__schema10"
    },
    "findingsDigest": {
      "$ref": "#/$defs/__schema11"
    },
    "verifiedAt": {
      "$ref": "#/$defs/__schema12"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "outcome",
    "acceptanceCheck",
    "evidence",
    "evidenceSetDigest",
    "verifier",
    "methodVersion",
    "state",
    "findingsRef",
    "findingsDigest",
    "verifiedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.4"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "digest": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema6": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "digest": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "independentFromProducer": {
          "type": "boolean"
        },
        "disclosureRef": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "id",
        "version",
        "independentFromProducer",
        "disclosureRef"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "indeterminate",
        "stale"
      ]
    },
    "__schema10": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema11": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema5"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema12": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.4:verification"
}
