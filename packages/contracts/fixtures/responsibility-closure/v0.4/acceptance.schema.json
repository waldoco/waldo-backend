{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.4"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "$ref": "#/$defs/__schema1"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "evidenceSetDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verificationIds": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "presence",
            "service",
            "provider",
            "person"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "explicit_owner",
        "delegated_policy"
      ]
    },
    "delegatedPolicyRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "reopened",
        "released"
      ]
    },
    "reasonRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "outcome",
    "evidenceSetDigest",
    "verificationIds",
    "actor",
    "mode",
    "delegatedPolicyRevision",
    "decision",
    "reasonRef",
    "recordedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$id": "urn:waldo:protocol:responsibility-closure:0.4:acceptance"
}
