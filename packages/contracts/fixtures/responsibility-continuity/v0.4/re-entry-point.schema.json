{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.4"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "$ref": "#/$defs/__schema1"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "outcome",
            "work_unit"
          ]
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "judgment",
        "execution",
        "verification",
        "conversation"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "lastStableEventId": {
      "$ref": "#/$defs/__schema0"
    },
    "nextAction": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/__schema0"
        },
        "ref": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "requiredContextRecipeRef": {
      "$ref": "#/$defs/__schema0"
    },
    "requiredContextRecipeDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidenceGapRefs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "artifactRefs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "eventCursor": {
      "$ref": "#/$defs/__schema1"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "subject",
    "mode",
    "summary",
    "lastStableEventId",
    "nextAction",
    "requiredContextRecipeRef",
    "requiredContextRecipeDigest",
    "evidenceGapRefs",
    "artifactRefs",
    "eventCursor",
    "expiresAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$id": "urn:waldo:protocol:responsibility-continuity:0.4:re-entry-point"
}
