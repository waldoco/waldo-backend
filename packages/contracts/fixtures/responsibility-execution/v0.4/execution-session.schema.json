{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.4"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema0"
    },
    "attemptId": {
      "$ref": "#/$defs/__schema0"
    },
    "provider": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "const": "provider"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "modelRef": {
          "$ref": "#/$defs/__schema0"
        },
        "manifest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "category",
        "id",
        "version",
        "modelRef",
        "manifest"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "const": "execution_environment"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "environmentKind": {
          "type": "string",
          "enum": [
            "local",
            "cloud",
            "human"
          ]
        },
        "manifest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "category",
        "id",
        "version",
        "environmentKind",
        "manifest"
      ],
      "additionalProperties": false
    },
    "providerSessionRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "starting",
        "active",
        "ended",
        "lost",
        "unknown"
      ]
    },
    "lastObservationSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "attemptId",
    "provider",
    "environment",
    "providerSessionRef",
    "state",
    "lastObservationSequence"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:waldo:protocol:responsibility-execution:0.4:execution-session"
}
