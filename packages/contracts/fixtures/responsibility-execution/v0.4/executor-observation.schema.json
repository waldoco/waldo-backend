{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "attemptId": {
      "$ref": "#/$defs/__schema1"
    },
    "environment": {
      "$ref": "#/$defs/__schema2"
    },
    "leaseId": {
      "$ref": "#/$defs/__schema1"
    },
    "fencingGeneration": {
      "$ref": "#/$defs/__schema4"
    },
    "cancellationGeneration": {
      "$ref": "#/$defs/__schema5"
    },
    "sequence": {
      "$ref": "#/$defs/__schema6"
    },
    "kind": {
      "$ref": "#/$defs/__schema7"
    },
    "payloadRef": {
      "$ref": "#/$defs/__schema8"
    },
    "payloadDigest": {
      "$ref": "#/$defs/__schema9"
    },
    "observedAt": {
      "$ref": "#/$defs/__schema10"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "attemptId",
    "environment",
    "leaseId",
    "fencingGeneration",
    "cancellationGeneration",
    "sequence",
    "kind",
    "payloadRef",
    "payloadDigest",
    "observedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.4"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "const": "execution_environment"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "version": {
          "$ref": "#/$defs/__schema1"
        },
        "environmentKind": {
          "type": "string",
          "enum": [
            "local",
            "cloud",
            "human"
          ]
        },
        "manifest": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema1"
            },
            "version": {
              "$ref": "#/$defs/__schema1"
            },
            "digest": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "id",
            "version",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "category",
        "id",
        "version",
        "environmentKind",
        "manifest"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "started",
        "activity",
        "candidate_artifact",
        "candidate_evidence",
        "ended",
        "failed",
        "timed_out",
        "unknown"
      ]
    },
    "__schema8": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema9": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema10": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-execution:0.4:executor-observation",
  "x-waldo-validation-level": "structural-plus-runtime-invariants"
}
