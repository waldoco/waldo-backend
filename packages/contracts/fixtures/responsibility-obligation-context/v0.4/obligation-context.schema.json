{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.4"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "$ref": "#/$defs/__schema1"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "acceptanceCriteria": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "declared"
            },
            "revision": {
              "$ref": "#/$defs/__schema1"
            },
            "digest": {
              "$ref": "#/$defs/__schema2"
            },
            "checks": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema3"
              }
            }
          },
          "required": [
            "state",
            "revision",
            "digest",
            "checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "absent"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "declined"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "outcome",
    "acceptanceCriteria",
    "recordedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        },
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "verificationMethod": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "deterministic_read_back"
                },
                "capability": {
                  "$ref": "#/$defs/__schema0"
                },
                "targetRef": {
                  "$ref": "#/$defs/__schema0"
                },
                "assertion": {
                  "type": "object",
                  "properties": {
                    "operator": {
                      "type": "string",
                      "const": "digest_equals"
                    },
                    "expectedDigest": {
                      "$ref": "#/$defs/__schema2"
                    }
                  },
                  "required": [
                    "operator",
                    "expectedDigest"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "capability",
                "targetRef",
                "assertion"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "deterministic_artifact_check"
                },
                "capability": {
                  "$ref": "#/$defs/__schema0"
                },
                "artifactRef": {
                  "$ref": "#/$defs/__schema0"
                },
                "assertion": {
                  "type": "object",
                  "properties": {
                    "operator": {
                      "type": "string",
                      "const": "digest_equals"
                    },
                    "expectedDigest": {
                      "$ref": "#/$defs/__schema2"
                    }
                  },
                  "required": [
                    "operator",
                    "expectedDigest"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "capability",
                "artifactRef",
                "assertion"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "criterion",
        "verificationMethod"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:waldo:protocol:responsibility-obligation-context:0.4:obligation-context",
  "x-waldo-validation-level": "structural-plus-runtime-and-binding-invariants",
  "x-waldo-offline-commands": "none"
}
