{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.4"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "$ref": "#/$defs/__schema1"
    },
    "presence": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "const": "presence"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "registrationRevision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "category",
        "id",
        "registrationRevision"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "const": "channel_adapter"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "manifest": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema0"
            },
            "version": {
              "$ref": "#/$defs/__schema0"
            },
            "digest": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "id",
            "version",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "category",
        "id",
        "version",
        "manifest"
      ],
      "additionalProperties": false
    },
    "projectionRef": {
      "$ref": "#/$defs/__schema0"
    },
    "projectionDigest": {
      "$ref": "#/$defs/__schema2"
    },
    "contentRef": {
      "$ref": "#/$defs/__schema0"
    },
    "contentDigest": {
      "$ref": "#/$defs/__schema2"
    },
    "dedupeKey": {
      "$ref": "#/$defs/__schema0"
    },
    "state": {
      "type": "string",
      "const": "pending_delivery"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "ownerId",
    "revision",
    "presence",
    "adapter",
    "projectionRef",
    "projectionDigest",
    "contentRef",
    "contentDigest",
    "dedupeKey",
    "state",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-presence-channel:0.4:delivery-intent",
  "x-waldo-validation-level": "structural-plus-runtime-invariants"
}
