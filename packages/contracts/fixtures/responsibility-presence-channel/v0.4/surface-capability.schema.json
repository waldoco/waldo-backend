{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.4"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "$ref": "#/$defs/__schema0"
    },
    "commands": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "projections": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "offlineCommands": {
      "type": "string",
      "const": "none"
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "version",
    "commands",
    "projections",
    "offlineCommands"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "conversation.send",
        "responsibility.capture"
      ]
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "conversation",
        "responsibility_status",
        "needs_you",
        "re_entry"
      ]
    }
  },
  "$id": "urn:waldo:protocol:responsibility-presence-channel:0.4:surface-capability"
}
