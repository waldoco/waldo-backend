{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.2"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "commandType": {
      "type": "string",
      "const": "responsibility.capture"
    },
    "presenceRegistrationId": {
      "$ref": "#/$defs/__schema0"
    },
    "aggregate": {
      "not": {}
    },
    "correlationId": {
      "$ref": "#/$defs/__schema0"
    },
    "clientIssuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "userStatement": {
          "$ref": "#/$defs/__schema1"
        },
        "mission": {
          "$ref": "#/$defs/__schema2"
        },
        "workUnits": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "userStatement"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "commandType",
    "presenceRegistrationId",
    "clientIssuedAt",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "brief": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "brief"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "responsibility": {
          "$ref": "#/$defs/__schema1"
        },
        "inputs": {
          "$ref": "#/$defs/__schema5"
        },
        "dependencyPositions": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "expectedEvidence": {
          "$ref": "#/$defs/__schema5"
        },
        "requiredCapabilities": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "stopConditions": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "responsibility",
        "inputs",
        "dependencyPositions",
        "expectedEvidence",
        "requiredCapabilities",
        "stopConditions"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema6": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    }
  },
  "$id": "urn:waldo:protocol:responsibility-handshake:0.2:responsibility-capture-request",
  "title": "Waldo responsibility-handshake v0.2 responsibility-capture-request",
  "description": "Structural interoperability schema. Canonical admission also requires the listed Waldo runtime invariants.",
  "x-waldo-validation-level": "structural",
  "x-waldo-runtime-validator-required": true,
  "x-waldo-runtime-invariants": {
    "admission": "strict command-specific schema before canonicalization",
    "userText": "well-formed UTF-16 with non-whitespace content",
    "maxPayloadUtf8Bytes": 16384,
    "maxWorkUnits": 32,
    "serverOwnedFields": "rejected"
  },
  "x-waldo-offline-commands": "none"
}
