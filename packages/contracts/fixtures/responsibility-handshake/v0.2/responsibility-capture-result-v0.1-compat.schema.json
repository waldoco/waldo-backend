{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "requestId": {
      "$ref": "#/$defs/__schema1"
    },
    "outcome": {
      "$ref": "#/$defs/__schema2"
    },
    "mission": {
      "$ref": "#/$defs/__schema4"
    },
    "workUnits": {
      "$ref": "#/$defs/__schema5"
    },
    "projectionCursor": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "protocolVersion",
    "ownerId",
    "requestId",
    "outcome",
    "mission",
    "workUnits",
    "projectionCursor"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.1"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "ownerId": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "userStatement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "state": {
          "type": "string",
          "const": "captured"
        },
        "createdAt": {
          "$ref": "#/$defs/__schema3"
        },
        "updatedAt": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "id",
        "ownerId",
        "revision",
        "userStatement",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema4": {
      "type": "null"
    },
    "__schema5": {
      "type": "array",
      "prefixItems": []
    },
    "__schema6": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$id": "urn:waldo:protocol:responsibility-handshake:0.2:responsibility-capture-result-v0.1-compat",
  "title": "Waldo responsibility-handshake v0.2 responsibility-capture-result-v0.1-compat",
  "description": "Structural interoperability schema. Canonical admission also requires the listed Waldo runtime invariants.",
  "x-waldo-validation-level": "structural",
  "x-waldo-runtime-validator-required": true,
  "x-waldo-runtime-invariants": {
    "compatibility": "released v0.1 simple capture returns no Mission or WorkUnits"
  },
  "x-waldo-offline-commands": "none"
}
