{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "ownerId": {
      "$ref": "#/$defs/__schema1"
    },
    "projectionName": {
      "$ref": "#/$defs/__schema1"
    },
    "snapshotId": {
      "$ref": "#/$defs/__schema1"
    },
    "snapshotBaseCursor": {
      "$ref": "#/$defs/__schema2"
    },
    "fromExclusiveCursor": {
      "$ref": "#/$defs/__schema2"
    },
    "highWaterCursor": {
      "$ref": "#/$defs/__schema2"
    },
    "nextCursor": {
      "$ref": "#/$defs/__schema2"
    },
    "items": {
      "$ref": "#/$defs/__schema3"
    },
    "hasMore": {
      "$ref": "#/$defs/__schema5"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "protocolVersion",
    "ownerId",
    "projectionName",
    "snapshotId",
    "snapshotBaseCursor",
    "fromExclusiveCursor",
    "highWaterCursor",
    "nextCursor",
    "items",
    "hasMore",
    "generatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "0.1"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema4"
          }
        }
      ]
    },
    "__schema5": {
      "type": "boolean"
    },
    "__schema6": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-handshake:0.1:projection-page",
  "title": "Waldo ProjectionPage protocol v0.1",
  "description": "Structural interoperability schema. Canonical admission also requires the listed Waldo runtime invariants.",
  "x-waldo-validation-level": "structural",
  "x-waldo-runtime-validator-required": true,
  "x-waldo-runtime-invariants": {
    "maxJsonDepthPerItem": 64,
    "maxJsonNodesPerItem": 4096,
    "maxItemsPerPage": 256,
    "maxPageUtf8Bytes": 262144,
    "wellFormedItemUnicode": true,
    "cursorOrder": "snapshotBaseCursor <= fromExclusiveCursor <= nextCursor <= highWaterCursor",
    "hasMore": "nextCursor < highWaterCursor"
  }
}
