          "enum": [
            "started",
            "progress",
            "provider_done",
            "failed"
          ]
        },
        "observedAt": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "trust",
        "sessionId",
        "workUnitId",
        "activity",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "__schema7": {
