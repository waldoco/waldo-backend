  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "string",
      "const": "agent_session.activity_observed"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent_session"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema3"
        }
      },
