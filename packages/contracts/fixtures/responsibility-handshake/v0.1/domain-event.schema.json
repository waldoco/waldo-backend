            "blocked",
            "risk_changed",
            "authority_required"
          ]
        },
        "optionRefs": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
