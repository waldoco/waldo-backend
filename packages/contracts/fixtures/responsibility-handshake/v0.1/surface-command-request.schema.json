{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "const": "0.1"
        },
        "requestId": {
          "$ref": "#/$defs/__schema0"
        },
        "commandType": {
          "type": "string",
          "const": "responsibility.capture"
        },
        "presenceRegistrationId": {
          "$ref": "#/$defs/__schema0"
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/__schema0"
            },
            "id": {
              "$ref": "#/$defs/__schema0"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "correlationId": {
          "$ref": "#/$defs/__schema0"
        },
        "clientIssuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "userStatement": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "userStatement"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "commandType",
        "presenceRegistrationId",
        "clientIssuedAt",
        "payload"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    }
  },
  "$id": "urn:waldo:protocol:responsibility-handshake:0.1:surface-command-request",
  "title": "Waldo SurfaceCommandRequest protocol v0.1",
  "description": "Structural interoperability schema. Canonical admission also requires the listed Waldo runtime invariants.",
  "x-waldo-validation-level": "structural",
  "x-waldo-runtime-validator-required": true,
  "x-waldo-runtime-invariants": {
    "admission": "commandType-discriminated concrete command schemas",
    "maxPayloadUtf8Bytes": 16384
  }
}
