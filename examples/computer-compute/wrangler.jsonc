{
  "name": "waldo-computer-compute-trial",
  "main": "worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "containers": [{
    "class_name": "OwnerComputeContainer",
    "scheduling_policy": "durable_object",
    "observability": { "enabled": false },
    "images": { "compute": { "dockerfile": "./Dockerfile" } }
  }],
  "durable_objects": {
    "bindings": [{ "class_name": "OwnerComputeContainer", "name": "OWNER_COMPUTE" }]
  },
  "exports": { "OwnerComputeContainer": { "type": "durable-object", "storage": "sqlite" } }
}
